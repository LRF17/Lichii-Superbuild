+    REQUIRE(resolved);
+    REQUIRE(resolved != VideoCommon::NULL_BUFFER_ID);
+    REQUIRE(resolved != id);
+    REQUIRE(Access::Get(*f.cache, resolved).IsInBounds(0x10800, 0x100));
+}
