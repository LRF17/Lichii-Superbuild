+    // and two bytes of each of the words at 0x880 and 0x884.
+    f.cache->Nx2NoteListHostWrite(0x20800, 0x40);
+    f.cache->Nx2NoteListHostWrite(0x20882, 4);
+    REQUIRE(f.cache->Nx2ReadListCopy(0x20800, list, true) == Read::Synced);
