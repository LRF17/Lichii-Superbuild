+    vec3 wide = (controls.flags & 2u) != 0u ? linear : bt709_to_bt2020 * linear;
+    vec3 y = pow(max(wide, vec3(0.0)) * (203.0 / 10000.0), vec3(0.1593017578125));
+    return pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), vec3(78.84375));
+}
+
+void main() {
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    ivec2 extent = imageSize(output_color);
+    if (any(greaterThanEqual(pixel, extent))) {
+        return;
+    }
+    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
+    vec3 composite = textureLod(native_composite, uv, 0).rgb;
+    if ((controls.flags & 1u) != 0u) {
+        vec3 scene = encode_hdr10(texelFetch(dlss_scene, pixel, 0).rgb);
+        vec3 reference = textureLod(native_scene, uv, 0).rgb;
+        vec3 overlay = composite - reference;
+        float difference = max(max(abs(overlay.r), abs(overlay.g)), abs(overlay.b));
+        // Preserve the native composite where HUD or postprocessing substantially changes color.
+        // PQ puts SDR white near 0.58, so the SDR composite's thresholds are scaled to it.
+        float coverage = smoothstep(0.015, 0.07, difference);
+        composite = mix(scene + overlay, composite, coverage);
+    }
+    imageStore(output_color, pixel, vec4(clamp(composite, 0.0, 1.0), 1.0));
+}
diff --git a/src/video_core/host_shaders/ocarina_dlss_4k_reference_hdr.comp b/src/video_core/host_shaders/ocarina_dlss_4k_reference_hdr.comp
